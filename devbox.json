{
    "packages": [
      "apache@latest",
      "nodejs@18"
    ],
    "env": {
      "DEVBOX_COREPACK_ENABLED": "true",

    },
    "shell": {
      "init_hook": [
        "npm install --save-dev jasmine"
      ],
      "scripts": {
        "validate": "node validate_against_schema.js",
        "serve": "docker run -dit -v $(pwd):/usr/local/apache2/htdocs --name my-running-app -p 8080:80 httpd:2.4"
      }
    }
  }